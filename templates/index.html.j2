<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#17144A">
<title>{{ brand }} — 전국 음악 공연 일정</title>
<meta name="description" content="전국 콘서트·페스티벌·클래식 공연 일정을 매일 정오에 업데이트합니다.">
<meta property="og:title" content="{{ brand }}">
<meta property="og:description" content="오늘 새로 뜬 공연 {{ counts.new }}개, 7일 안에 열리는 공연 {{ counts.week }}개">
{% if og_image %}<meta property="og:image" content="{{ og_image }}">{% endif %}
<style>
{{ base_css|safe }}
html { -webkit-text-size-adjust: 100%; }
body { background: var(--night); color: var(--stock); font-family: "Pretendard", system-ui, sans-serif; font-size: 16px; line-height: 1.5;
  padding-bottom: env(safe-area-inset-bottom); }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--spot); outline-offset: 2px; }

header { padding: 28px 16px 8px; max-width: 640px; margin: 0 auto; position: relative; }
header::before { content: ""; position: absolute; inset: -40px -20px auto; height: 260px; z-index: -1;
  background: radial-gradient(ellipse 60% 70% at 85% 0, rgba(255,210,63,.22), transparent 70%); }
.brand { font-weight: 700; color: var(--dim); font-size: 14px; }
h1 { font-family: "BlackHan"; font-weight: 400; font-size: 44px; line-height: 1.05; margin-top: 10px; letter-spacing: -.5px; }
h1 .d { color: var(--spot); }
.sum { margin-top: 12px; color: var(--dim); font-size: 15px; }
.sum b { color: var(--stock); }
.sum b.n { color: var(--glow); }
.nb { white-space: nowrap; }

.controls { position: sticky; top: 0; z-index: 5; background: var(--night); padding: 10px 0 10px; border-bottom: 1px solid var(--night-2); }
.controls .in { max-width: 640px; margin: 0 auto; padding: 0 16px; }
.search { width: 100%; height: 44px; border-radius: 14px; border: 0; background: var(--night-2); color: var(--stock);
  padding: 0 14px; font: inherit; font-size: 16px; }
.search::placeholder { color: var(--dim); }
.chips { display: flex; gap: 8px; overflow-x: auto; margin: 10px -16px 0; padding: 0 16px 2px; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; height: 34px; padding: 0 14px; border-radius: 17px; border: 1.5px solid var(--night-2); background: transparent;
  color: var(--stock); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
.chip[aria-pressed="true"] { background: var(--stock); color: var(--ink); border-color: var(--stock); }
.chip.newonly[aria-pressed="true"] { background: var(--glow); border-color: var(--glow); color: #fff; }

main { max-width: 640px; margin: 0 auto; padding: 0 16px 40px; }
.day { margin-top: 26px; }
.day h2 { font-family: "BlackHan"; font-weight: 400; font-size: 22px; display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; }
.day h2 span { font-family: "Pretendard"; font-size: 14px; font-weight: 500; color: var(--dim); }
.day h2.today { color: var(--spot); }

.stub { display: flex; background: var(--stock); color: var(--ink); border-radius: 16px; margin-bottom: 10px; cursor: pointer; width: 100%;
  text-align: left; border: 0; font: inherit;
  -webkit-mask: radial-gradient(circle 9px at 76px 0, transparent 8.5px, #000 9px) top / 100% 51% no-repeat,
                radial-gradient(circle 9px at 76px 100%, transparent 8.5px, #000 9px) bottom / 100% 51% no-repeat; }
.stub .date { width: 76px; flex: none; border-right: 2px dashed var(--stock-edge); display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 10px 4px; }
.stub .md { font-family: "BlackHan"; font-size: 22px; line-height: 1; }
.stub .wd { font-size: 12px; font-weight: 700; color: var(--ink-soft); margin-top: 4px; }
.stub .body { flex: 1; min-width: 0; padding: 12px 14px 12px 14px; }
.stub .t { word-break: keep-all; font-weight: 800; font-size: 16px; line-height: 1.3; letter-spacing: -.2px; }
.stub .w { font-size: 13px; color: var(--ink-soft); margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.stub .p { display: flex; gap: 6px; align-items: center; margin-top: 6px; font-size: 13px; font-weight: 700; min-width: 0; }
.stub .p span:last-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rg { flex: none; background: var(--ink); color: var(--stock); border-radius: 6px; padding: 1px 7px; font-size: 12px; }
.nw { display: inline-block; background: var(--glow); color: #fff; font-family: "BlackHan"; font-size: 11px; border-radius: 5px; padding: 1px 6px 2px; margin-right: 6px; vertical-align: 2px; }
.tk { color: #B3126A; font-size: 12px; font-weight: 700; margin-top: 4px; }
.thumb { width: 62px; flex: none; margin: 8px 8px 8px 0; border-radius: 10px; background: var(--stock-edge) center/cover no-repeat; }

.detail { background: var(--night-2); border-radius: 16px; margin: -4px 0 12px; padding: 14px 16px; font-size: 14px; display: none; }
.detail.open { display: block; }
.detail dl { display: grid; grid-template-columns: 64px 1fr; gap: 6px 10px; }
.detail dt { color: var(--dim); }
.detail dd { word-break: keep-all; }
.links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.links a { background: var(--spot); color: var(--ink); text-decoration: none; font-weight: 700; padding: 8px 14px; border-radius: 10px; font-size: 14px; }
.links a.src { background: transparent; color: var(--stock); border: 1.5px solid var(--dim); font-weight: 500; }
.conf { margin-top: 10px; color: var(--dim); font-size: 12px; }

.empty { text-align: center; color: var(--dim); padding: 60px 0; }
footer { max-width: 640px; margin: 0 auto; padding: 20px 16px 48px; color: var(--dim); font-size: 12px; line-height: 1.7; }
@media (prefers-reduced-motion: no-preference) { .detail.open { animation: drop .18s ease-out; } @keyframes drop { from { opacity: 0; transform: translateY(-4px); } } }
</style>
</head>
<body>
<header>
  <div class="brand">{{ brand }}</div>
  <h1><span class="d">{{ today_md }}</span> 전국<br>음악 공연</h1>
  <p class="sum">오늘 새로 뜬 공연 <span class="nb"><b class="n">{{ counts.new }}</b>개</span>, 7일 안에 열리는 공연 <span class="nb"><b>{{ counts.week }}</b>개</span>, <span class="nb">전체 <b>{{ counts.total }}</b>개</span></p>
</header>

<div class="controls"><div class="in">
  <input class="search" type="search" placeholder="아티스트, 공연명, 공연장 검색" aria-label="검색">
  <div class="chips" role="toolbar" aria-label="필터">
    <button class="chip newonly" data-new aria-pressed="false">새로 뜬 공연</button>
    <button class="chip" data-region="" aria-pressed="true">전국</button>
    {% for r in regions %}<button class="chip" data-region="{{ r }}" aria-pressed="false">{{ r }}</button>{% endfor %}
  </div>
</div></div>

<main id="list" aria-live="polite"></main>

<footer>
  매일 정오 업데이트 ({{ updated }} 기준). KOPIS 공연예술통합전산망, 지자체·공공데이터포털, 뉴스·카페·SNS 게시물을 모아 정리했습니다.
  뉴스·SNS에서만 확인된 공연은 '확인 필요'로 표시되니 예매 전 공식 공지를 확인하세요.
</footer>

<script>
const EVENTS = {{ events_json|safe }};
const TODAY = "{{ today_iso }}";
const WD = "일월화수목금토";
const st = { q: "", region: "", newOnly: false };
const $list = document.getElementById("list");

const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const md = iso => { const d = new Date(iso + "T00:00:00"); return `${d.getMonth()+1}.${d.getDate()}`; };
const wd = iso => WD[new Date(iso + "T00:00:00").getDay()];
const safeUrl = u => /^https?:\/\//.test(u || "") ? u : "";

function matches(e) {
  if (st.region && e.region !== st.region) return false;
  if (st.newOnly && !e.is_new) return false;
  if (st.q) {
    const blob = (e.title + " " + e.artists.join(" ") + " " + e.venue).toLowerCase();
    if (!blob.includes(st.q)) return false;
  }
  return true;
}

function row(e, i) {
  const start = e.start_date < TODAY ? TODAY : e.start_date;
  const links = e.ticket_links.filter(l => safeUrl(l.url)).map(l => `<a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.name || "예매")}</a>`).join("");
  const srcs = e.sources.filter(s => safeUrl(s.url)).slice(0, 3).map(s => `<a class="src" href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.label)}</a>`).join("");
  return `
  <button class="stub" aria-expanded="false" aria-controls="d${i}">
    <div class="date">${e.long_run
      ? `<div class="md">${md(e.end_date)}</div><div class="wd">까지</div>`
      : `<div class="md">${md(start)}</div><div class="wd">${wd(start)}</div>`}</div>
    <div class="body">
      <div class="t">${e.is_new ? '<span class="nw">NEW</span>' : ""}${esc(e.title)}</div>
      ${e.artists.length ? `<div class="w">${esc(e.artists.join(", "))}</div>` : ""}
      <div class="p">${e.region ? `<span class="rg">${esc(e.region)}</span>` : ""}<span>${esc(e.venue || "장소 미정")}</span></div>
      ${e.ticket_open ? `<div class="tk">티켓 오픈 ${esc(e.ticket_open)}</div>` : ""}
    </div>
    ${safeUrl(e.poster) ? `<div class="thumb" style="background-image:url('${esc(e.poster)}')"></div>` : ""}
  </button>
  <div class="detail" id="d${i}">
    <dl>
      <dt>기간</dt><dd>${md(e.start_date)}(${wd(e.start_date)})${e.end_date !== e.start_date ? ` ~ ${md(e.end_date)}(${wd(e.end_date)})` : ""}</dd>
      ${e.times ? `<dt>시간</dt><dd>${esc(e.times)}</dd>` : ""}
      ${e.price ? `<dt>가격</dt><dd>${esc(e.price)}</dd>` : ""}
      <dt>장르</dt><dd>${esc(e.genre)}</dd>
    </dl>
    <div class="links">${links}${srcs}</div>
    ${e.confidence < 0.9 ? '<div class="conf">뉴스·SNS에서만 확인된 공연이에요. 예매 전 공식 공지를 확인하세요.</div>' : ""}
  </div>`;
}

function render() {
  const items = EVENTS.filter(matches);
  if (!items.length) {
    $list.innerHTML = `<p class="empty">조건에 맞는 공연이 없어요.<br>다른 지역이나 검색어로 찾아보세요.</p>`;
    return;
  }
  const groups = new Map();
  const longRuns = items.filter(e => e.long_run);
  for (const e of items.filter(e => !e.long_run)) {
    const k = e.start_date < TODAY ? TODAY : e.start_date;
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k).push(e);
  }
  let html = "", i = 0;
  for (const [k, evs] of [...groups].sort()) {
    const label = k === TODAY ? "오늘" : `${md(k)} ${wd(k)}요일`;
    html += `<section class="day"><h2 class="${k === TODAY ? "today" : ""}">${label}<span>${evs.length}개</span></h2>`;
    for (const e of evs) html += row(e, i++);
    html += `</section>`;
  }
  if (longRuns.length) {
    html += `<section class="day"><h2>상설·장기 공연<span>${longRuns.length}개</span></h2>`;
    for (const e of longRuns.sort((a, b) => a.end_date.localeCompare(b.end_date))) html += row(e, i++);
    html += `</section>`;
  }
  $list.innerHTML = html;
}

$list.addEventListener("click", ev => {
  const b = ev.target.closest(".stub"); if (!b) return;
  const d = document.getElementById(b.getAttribute("aria-controls"));
  const open = d.classList.toggle("open");
  b.setAttribute("aria-expanded", open);
});
document.querySelector(".search").addEventListener("input", e => { st.q = e.target.value.trim().toLowerCase(); render(); });
document.querySelectorAll(".chip[data-region]").forEach(c => c.addEventListener("click", () => {
  st.region = c.dataset.region;
  document.querySelectorAll(".chip[data-region]").forEach(x => x.setAttribute("aria-pressed", x === c));
  render();
}));
document.querySelector(".chip[data-new]").addEventListener("click", e => {
  st.newOnly = !st.newOnly; e.currentTarget.setAttribute("aria-pressed", st.newOnly); render();
});
render();
</script>
</body>
</html>
