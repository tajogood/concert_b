<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<style>
{{ base_css|safe }}
html, body { width: 1080px; height: 1350px; overflow: hidden; }
body { background: var(--night); color: var(--stock); font-family: "Pretendard", "Noto Sans CJK KR", sans-serif; position: relative; }
body::before { content: ""; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 70% 55% at 82% -8%, rgba(255,210,63,.24), transparent 70%); }
.frame { position: relative; height: 100%; padding: 84px 72px 64px; display: flex; flex-direction: column; }
.top { display: flex; align-items: center; font-size: 30px; font-weight: 500; color: var(--dim); }
.top img { width: 96px; height: 96px; margin: -20px 0 -20px -8px; }
.top .ctx { margin-left: auto; margin-right: 28px; }
.credit { margin-top: auto; padding-top: 24px; font-size: 24px; color: var(--dim); }

/* 사진은 자르거나 고치지 않고 그대로 (관광공사 사진 이용조건) */
.photo { background: var(--night-2) center / contain no-repeat; border-radius: 36px; }

/* cover */
.cv-photo { height: 640px; margin-top: 44px; }
.chip { display: inline-block; align-self: flex-start; background: var(--stock); color: var(--ink); border-radius: 14px;
  padding: 6px 18px 8px; font-size: 32px; font-weight: 800; margin-top: 40px; }
.cv-title { font-family: "BlackHan"; font-size: 96px; line-height: 1.08; letter-spacing: -2px; margin-top: 20px; word-break: keep-all;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cv-range { font-family: "BlackHan"; font-size: 58px; color: var(--spot); margin-top: 18px; }

/* info */
.head { font-family: "BlackHan"; font-size: 92px; line-height: 1.05; margin: 40px 0 36px; letter-spacing: -1px; }
.head small { display: block; font-family: "Pretendard"; font-size: 34px; font-weight: 500; color: var(--dim); margin-top: 14px; letter-spacing: 0; }
.rows { display: grid; grid-template-columns: 150px 1fr; gap: 18px 24px; background: var(--night-2); border-radius: 28px; padding: 36px 40px; font-size: 36px; }
.rows dt { color: var(--dim); font-weight: 600; }
.rows dd { font-weight: 700; word-break: keep-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.story { font-size: 36px; line-height: 1.6; margin-top: 40px; word-break: keep-all;
  display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical; overflow: hidden; }

/* spot */
.sp-kicker { font-family: "BlackHan"; font-size: 64px; color: var(--spot); margin-top: 36px; }
.sp-photo { height: 600px; margin-top: 30px; }
.sp-photo.tall { height: 700px; margin-top: 44px; }
.sp-title { font-family: "BlackHan"; font-size: 80px; line-height: 1.1; letter-spacing: -1.5px; margin-top: 34px; word-break: keep-all; }
.sp-dist { font-size: 34px; font-weight: 800; color: var(--spot); margin-top: 14px; }
.sp-addr { font-size: 28px; color: var(--dim); margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sp-ov { font-size: 32px; line-height: 1.55; color: var(--stock); margin-top: 18px; word-break: keep-all;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

/* outro */
.outro-big { font-family: "BlackHan"; font-size: 132px; line-height: 1.08; margin-top: 120px; letter-spacing: -2px; }
.outro-big em { font-style: normal; color: var(--spot); }
.outro-p { font-size: 40px; font-weight: 500; line-height: 1.55; margin-top: 60px; }
.url { margin-top: auto; background: var(--stock); color: var(--ink); border-radius: 26px; padding: 34px 40px; font-size: 36px; font-weight: 800; word-break: break-all; }
.outro .credit { margin-top: 26px; padding-top: 0; }
</style>
</head>
<body>
<div class="frame{% if slide.kind == 'outro' %} outro{% endif %}">
  <div class="top"><img src="{{ logo }}" alt="{{ brand }}"><span class="ctx">{{ place }} 축제</span><span class="pager">{{ index }}/{{ total }}</span></div>

{% if slide.kind == "fest_cover" %}
  <div class="photo cv-photo" style="background-image:url('{{ e.poster }}')"></div>
  <div class="chip">{{ place }}</div>
  <div class="cv-title">{{ e.title }}</div>
  <div class="cv-range">{{ range_label }}</div>
  <div class="credit">{% if post.spots %}넘기면 축제 정보와 근처 가볼 만한 곳이 나와요{% else %}넘기면 축제 정보가 나와요{% endif %}</div>

{% elif slide.kind == "fest_info" %}
  <div class="head">축제 정보<small>{{ e.title }}</small></div>
  <dl class="rows">
    <dt>기간</dt><dd>{{ range_label }}</dd>
    {% if e.venue %}<dt>장소</dt><dd>{{ e.venue }}</dd>{% endif %}
    {% if e.times %}<dt>시간</dt><dd>{{ e.times }}</dd>{% endif %}
    {% if e.price %}<dt>요금</dt><dd>{{ e.price }}</dd>{% endif %}
  </dl>
  {% if e.story %}<div class="story">{{ e.story }}</div>{% endif %}
  <div class="credit">{{ data_credit }}</div>

{% elif slide.kind == "spot" %}
  {% if slide.first %}<div class="sp-kicker">근처 가볼 만한 곳</div>{% endif %}
  <div class="photo sp-photo{% if not slide.first %} tall{% endif %}" style="background-image:url('{{ slide.spot.image }}')"></div>
  <div class="sp-title">{{ slide.spot.title }}</div>
  <div class="sp-dist">축제장에서 {{ slide.spot.dist_km }}km</div>
  {% if slide.spot.addr %}<div class="sp-addr">{{ slide.spot.addr }}</div>{% endif %}
  {% if slide.spot.overview %}<div class="sp-ov">{{ slide.spot.overview }}</div>{% endif %}
  <div class="credit">사진·정보: 한국관광공사</div>

{% elif slide.kind == "outro" %}
  <div class="outro-big">다른 축제도<br><em>여기</em>에<br>다 있어요</div>
  <div class="outro-p">전국 지역 축제와 공연 일정을<br>프로필 링크에서 확인하세요.</div>
  <div class="url">{{ site_url_short }}</div>
  <div class="credit">{{ data_credit }}</div>
{% endif %}
</div>
</body>
</html>
